<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0E3A56">
<meta name="description" content="نِبراس — منصة معرفية عربية متخصصة في منافسات التحكيم التجاري الدولية">
<title>نِبراس | منصة المعرفة والتأهيل لمنافسات التحكيم التجاري الدولية</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Markazi+Text:wght@500;600;700&family=Tajawal:wght@400;500;700;800&display=swap');

:root{
  --navy:#0E3A56;
  --navy-2:#124A64;
  --navy-ink:#0A2A3D;
  --gold:#B9862F;
  --gold-light:#E0B15E;
  --paper:#FBF8F1;
  --card:#FFFFFF;
  --line:#E7DFCB;
  --line-soft:#EFE9D8;
  --ink:#20242B;
  --muted:#6E7278;
  --shadow:0 24px 60px -30px rgba(14,58,86,.35);
  --seal:4px 26px 4px 26px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"Tajawal",system-ui,sans-serif;line-height:1.85;font-size:16px}
a{text-decoration:none;color:inherit}
.container{width:min(1180px,calc(100% - 40px));margin:auto}
h1,h2,h3,.display{font-family:"Markazi Text","Tajawal",serif}
::selection{background:var(--gold-light);color:var(--navy-ink)}

/* ===== nav ===== */
.nav{position:sticky;top:0;z-index:60;background:rgba(251,248,241,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav-in{height:82px;display:flex;align-items:center;gap:26px}
.brand{display:flex;align-items:center;gap:10px}
.brand img{height:44px;width:auto;display:block}
.brand b{font-family:"Markazi Text";font-size:22px;color:var(--navy);letter-spacing:.5px}
.menu{display:flex;gap:2px;align-items:center;margin-inline-start:8px;overflow-x:auto;scrollbar-width:none}
.menu::-webkit-scrollbar{display:none}
.menu a{padding:10px 14px;border-radius:9px;color:#43535E;font-size:14px;font-weight:500;white-space:nowrap;position:relative}
.menu a:hover{color:var(--navy)}
.menu a.active{color:var(--navy);font-weight:700}
.menu a.active:after{content:"";position:absolute;right:14px;left:14px;bottom:2px;height:2px;background:var(--gold)}
.nav-actions{display:flex;gap:8px;margin-inline-start:auto}
.icon-btn{border:1px solid var(--line);background:var(--card);width:40px;height:40px;border-radius:11px;cursor:pointer;color:var(--navy);font-size:15px}
.icon-btn:hover{border-color:var(--gold)}

/* ===== hero ===== */
.hero{background:var(--card);position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
.hero:before{content:"";position:absolute;inset:-30% -10% auto auto;width:640px;height:640px;background:radial-gradient(circle,rgba(185,134,47,.10),transparent 70%)}
.hero-in{min-height:520px;display:grid;grid-template-columns:1.08fr .92fr;gap:60px;align-items:center;padding:76px 0;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--gold);font-weight:700;font-size:13px}
.eyebrow i{width:6px;height:6px;background:var(--gold);transform:rotate(45deg);display:inline-block}
h1{font-size:clamp(34px,4.6vw,58px);line-height:1.28;color:var(--navy);margin:16px 0;font-weight:600}
.rule{width:74px;height:3px;background:var(--gold);margin:6px 0 22px;border-radius:2px}
.hero p.lead{font-size:17.5px;color:var(--muted);max-width:560px}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{padding:13px 22px;border-radius:var(--seal);border:1px solid var(--navy);font-weight:700;font-size:14px;display:inline-flex;gap:8px;align-items:center;transition:.2s}
.btn.primary{background:var(--navy);color:#fff}
.btn.primary:hover{background:var(--navy-ink)}
.btn.secondary{background:transparent;color:var(--navy)}
.btn.secondary:hover{border-color:var(--gold);color:var(--gold)}

.hero-art{display:grid;place-items:center;position:relative}
.emblem-frame{width:min(380px,92%);aspect-ratio:1;border:1px solid var(--line);border-radius:var(--seal);background:linear-gradient(160deg,#fff,#F6F1E4);display:grid;place-items:center;box-shadow:var(--shadow);position:relative;padding:30px}
.emblem-frame img{width:78%;height:auto;animation:rise .9s ease both}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.ledger-tag{position:absolute;background:var(--navy);color:#fff;padding:9px 16px;border-radius:var(--seal);font-size:12px;font-weight:700;box-shadow:0 12px 26px rgba(14,58,86,.25)}
.ledger-tag.one{top:14px;right:-16px}
.ledger-tag.two{bottom:22px;left:-18px;background:var(--gold);color:var(--navy-ink)}

.stat-strip{border-top:1px solid var(--line);background:#F5F0E2}
.stat-in{display:flex;justify-content:space-between;padding:22px 0;flex-wrap:wrap;gap:18px}
.stat{display:flex;align-items:baseline;gap:8px}
.stat b{font-family:"Markazi Text";font-size:26px;color:var(--navy)}
.stat span{font-size:13px;color:var(--muted)}
#viewersNow{display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--muted)}
#viewersNow .lit{width:7px;height:7px;border-radius:50%;background:#4C9A63;box-shadow:0 0 0 3px rgba(76,154,99,.18)}

/* ===== sections generic ===== */
section{padding:92px 0}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:36px}
.section-head h2{font-size:32px;color:var(--navy);margin:0;font-weight:600}
.section-head p{margin:6px 0 0;color:var(--muted);font-size:15px}
.section-num{font-family:"Markazi Text";color:var(--gold);font-size:15px;font-weight:700;letter-spacing:1px}

/* ledger portals (replaces generic quick-card grid) */
.ledger{border:1px solid var(--line);border-radius:var(--seal);background:var(--card);overflow:hidden}
.ledger a{display:grid;grid-template-columns:110px 1fr auto;align-items:center;gap:18px;padding:22px 26px;border-bottom:1px solid var(--line-soft);transition:.2s}
.ledger a:last-child{border-bottom:0}
.ledger a:hover{background:#F8F4E8}
.ledger .tag{font-family:"Markazi Text";color:var(--gold);font-size:15px;font-weight:700}
.ledger h3{margin:0;color:var(--navy);font-size:17px}
.ledger p{margin:4px 0 0;color:var(--muted);font-size:13px}
.ledger .go{color:var(--navy);font-size:13px;font-weight:700;opacity:.6}
.ledger a:hover .go{opacity:1;color:var(--gold)}

/* timeline */
.timeline{position:relative;padding:6px 0}
.timeline:before{content:"";position:absolute;right:33px;top:6px;bottom:6px;width:1px;background:var(--line)}
.step{display:grid;grid-template-columns:68px 1fr;gap:22px;margin:0 0 22px;position:relative}
.step-no{width:66px;height:66px;border-radius:50%;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;color:var(--navy);font-family:"Markazi Text";font-weight:700;font-size:20px;z-index:2}
.step-card{background:var(--card);border:1px solid var(--line);border-radius:var(--seal);padding:22px 26px}
.step-card small{color:var(--gold);font-weight:700;font-size:12px;letter-spacing:.5px}
.step-card h3{margin:5px 0;color:var(--navy);font-size:18px}
.step-card p{margin:0;color:var(--muted);font-size:14px}

/* tabs — animated pill with sliding indicator */
.tabs-wrap{display:inline-flex;background:var(--navy);padding:5px;border-radius:var(--seal);position:relative}
.tabs-wrap .indicator{position:absolute;top:5px;bottom:5px;background:var(--gold);border-radius:calc(var(--seal) - 2px);transition:transform .35s cubic-bezier(.65,0,.35,1),width .35s cubic-bezier(.65,0,.35,1);z-index:1}
.tabs-wrap button{position:relative;z-index:2;border:0;background:transparent;padding:10px 20px;border-radius:inherit;cursor:pointer;font:inherit;font-weight:700;color:#CFE0E9;font-size:14px;transition:color .3s}
.tabs-wrap button.active{color:var(--navy-ink)}

/* people / volunteer cards */
.people-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.person-card{background:var(--card);border:1px solid var(--line);border-radius:var(--seal);overflow:hidden;transition:.25s;display:flex;flex-direction:column}
.person-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:var(--gold-light)}
.person-photo{aspect-ratio:16/9;background:linear-gradient(160deg,#F1EBDB,#E7DEC4);position:relative;overflow:hidden}
.person-photo img{width:100%;height:100%;object-fit:cover;display:block}
.person-photo .ribbon{position:absolute;top:10px;left:10px;background:var(--navy);color:#fff;font-size:11px;padding:5px 10px;border-radius:8px;font-weight:700}
.person-body{padding:20px 22px 22px;flex:1;display:flex;flex-direction:column}
.person-body h3{margin:0;color:var(--navy);font-size:18px}
.person-body .role{color:var(--gold);font-size:12.5px;font-weight:700;margin:4px 0 10px}
.person-body p.bio{margin:0 0 16px;color:var(--muted);font-size:13.5px;flex:1}
.contact-row{display:flex;gap:8px;flex-wrap:wrap;padding-top:14px;border-top:1px solid var(--line-soft)}
.contact-row a{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--navy);border:1px solid var(--line);padding:7px 11px;border-radius:9px;transition:.2s}
.contact-row a:hover{border-color:var(--gold);color:var(--gold-light);background:var(--navy)}
.contact-row svg{width:14px;height:14px;flex:none}

/* library */
.library-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.resource{background:var(--card);border:1px solid var(--line);border-radius:var(--seal);padding:24px;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:start}
.resource-mark{font-family:"Markazi Text";color:var(--gold);font-size:22px;font-weight:700}
.resource h3{margin:0;color:var(--navy);font-size:16px}
.resource p{margin:6px 0 0;color:var(--muted);font-size:13px}
.resource .go{color:var(--navy);font-weight:700;font-size:12px;white-space:nowrap;opacity:.6}

/* academy / team tools / research / awards — banner style panels */
.panel{background:var(--navy);color:#EAF1F5;border-radius:var(--seal);padding:48px;position:relative;overflow:hidden}
.panel:before{content:"";position:absolute;width:420px;height:420px;border:1px solid rgba(255,255,255,.10);border-radius:50%;left:-140px;top:-160px}
.panel h2{font-size:30px;margin:0;color:#fff}
.panel p{color:#C9DCE6;max-width:640px}
.path{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:28px;position:relative}
.path-item{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.05);padding:18px;border-radius:12px}
.path-item b{display:block;color:var(--gold-light);margin-bottom:4px;font-family:"Markazi Text";font-size:18px}
.path-item span{font-size:13px;color:#D7E5EC}

.panel.light{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.panel.light:before{border-color:var(--line-soft)}
.panel.light h2{color:var(--navy)}
.panel.light p{color:var(--muted)}
.tool-grid,.award-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:26px;position:relative}
.tool-card,.award-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:20px}
.panel.light .tool-card,.panel.light .award-card{background:#F8F4E8;border:1px solid var(--line)}
.tool-card h3,.award-card h3{margin:0 0 6px;font-size:16px;color:inherit}
.tool-card p,.award-card p{margin:0;font-size:13px;opacity:.85}

/* author / footer */
.author{background:var(--card);border:1px solid var(--line);border-radius:var(--seal);padding:36px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}
.author h2{color:var(--navy);margin:0;font-size:24px}
.author p{color:var(--muted);margin:8px 0 18px}
.mark-box{width:120px;height:120px;border:1px solid var(--line);border-radius:var(--seal);display:grid;place-items:center;background:#F6F1E4}
.mark-box img{width:64%}
.disclaimer{margin-top:26px;padding:18px 22px;background:#F5EEDD;border:1px solid #E6D6A8;border-radius:14px;color:#6B5A2F;font-size:13px}

.footer{background:var(--navy-ink);color:#CBDAE1;padding:60px 0 26px}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:44px}
.footer h3{margin-top:0;color:#fff;font-weight:600;font-family:"Markazi Text";font-size:20px}
.footer p,.footer a{color:#A9C0CB;font-size:13.5px}
.footer a:hover{color:var(--gold-light)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.10);margin-top:36px;padding-top:20px;color:#84A0AC;font-size:12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}

@media(max-width:900px){
 .menu{display:none}
 .hero-in{grid-template-columns:1fr;padding:54px 0}
 .hero-art{order:-1;min-height:280px}
 .people-grid{grid-template-columns:1fr 1fr}
 .library-grid{grid-template-columns:1fr}
 .path,.tool-grid,.award-grid{grid-template-columns:1fr 1fr}
 .author{grid-template-columns:1fr;text-align:center}
 .mark-box{margin:auto}
 .footer-grid{grid-template-columns:1fr 1fr}
}
/* library sidebar */
.library-shell{display:grid;grid-template-columns:220px 1fr;gap:24px;margin-top:28px;align-items:start}
.lib-sidebar{display:flex;flex-direction:column;gap:8px;position:sticky;top:100px}
.lib-tab{text-align:right;border:1px solid var(--line);background:var(--card);padding:14px 18px;border-radius:var(--seal);font:inherit;font-weight:700;color:#43535E;cursor:pointer;transition:.2s}
.lib-tab.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.lib-tab:hover:not(.active){border-color:var(--gold)}

/* author community badge */
.community-badge{margin-top:26px;padding:22px 24px;background:#F5EEDD;border:1px solid #E6D6A8;border-radius:var(--seal);display:flex;align-items:center;gap:18px}
.community-badge img{width:76px;height:76px;border-radius:16px;object-fit:cover;flex:none;box-shadow:0 10px 22px -10px rgba(0,0,0,.3)}
.community-badge h3{margin:0 0 6px;color:var(--navy);font-size:17px}
.community-badge p{margin:0;color:#6B5A2F;font-size:13px;line-height:1.8}

/* ===== compass / wheel navigation for steps ===== */
.compass-block{margin-top:10px}
.compass-block.on-dark{--cnode-bg:rgba(255,255,255,.08);--cnode-border:rgba(255,255,255,.22);--cnode-color:#EAF1F5;--chub-bg:var(--gold);--chub-color:var(--navy-ink)}
.compass-block:not(.on-dark){--cnode-bg:var(--card);--cnode-border:var(--line);--cnode-color:var(--navy);--chub-bg:var(--navy);--chub-color:#fff}
.compass-wrap{--r:132px;position:relative;width:320px;height:320px;max-width:100%;margin:12px auto 30px}
.compass-ring{position:absolute;inset:14px;border:1px dashed var(--cnode-border);border-radius:50%}
.compass-hub{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:112px;height:112px;border-radius:50%;background:var(--chub-bg);color:var(--chub-color);display:grid;place-items:center;text-align:center;font-family:"Markazi Text";font-size:15px;line-height:1.25;font-weight:700;box-shadow:0 20px 40px -18px rgba(14,58,86,.45);z-index:2;padding:6px}
.compass-node{position:absolute;top:50%;left:50%;width:62px;height:62px;margin:-31px;transform:rotate(var(--angle)) translate(var(--r)) rotate(calc(-1 * var(--angle)));border-radius:50%;background:var(--cnode-bg);border:1px solid var(--cnode-border);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;cursor:pointer;font:inherit;font-size:11px;font-weight:700;color:var(--cnode-color);transition:.25s;z-index:3;padding:0}
.compass-node b{font-family:"Markazi Text";font-size:15px;display:block;line-height:1}
.compass-node span{display:block;max-width:52px;line-height:1.1}
.compass-node.active{background:var(--gold);border-color:var(--gold);color:var(--navy-ink);transform:rotate(var(--angle)) translate(var(--r)) rotate(calc(-1 * var(--angle))) scale(1.1);box-shadow:0 10px 22px -8px rgba(185,134,47,.6)}
.compass-node:hover{border-color:var(--gold-light)}
.compass-detail{max-width:640px;margin:0 auto}
.compass-detail .detail-box{display:none;background:var(--cnode-bg);border:1px solid var(--cnode-border);border-radius:var(--seal);padding:22px 26px;animation:rise .35s ease both}
.compass-block.on-dark .compass-detail .detail-box{background:rgba(255,255,255,.06)}
.compass-detail .detail-box.active{display:block}
.compass-detail small{color:var(--gold-light);font-weight:700;font-size:12px;letter-spacing:.5px}
.compass-block:not(.on-dark) .compass-detail small{color:var(--gold)}
.compass-detail h3{margin:6px 0;font-size:18px;color:var(--cnode-color)}
.compass-detail p{margin:0;font-size:14px;opacity:.9;color:var(--cnode-color)}
/* experience articles (details/summary) */
.article-list{display:flex;flex-direction:column;gap:12px;margin-top:20px}
.article{background:var(--card);border:1px solid var(--line);border-radius:var(--seal);overflow:hidden}
.article .article-photo{height:220px;overflow:hidden;background:#F1EBDB;display:flex;align-items:center;justify-content:center}
.article .article-photo img{max-width:100%;max-height:100%;width:auto;height:100%;object-fit:contain;display:block}
.article-toggle summary{list-style:none;cursor:pointer;padding:18px 24px;display:flex;align-items:center;gap:16px;justify-content:space-between}
.article-toggle summary::-webkit-details-marker{display:none}
.article-toggle summary .who{display:flex;flex-direction:column;gap:3px;flex:1}
.article-toggle summary h3{margin:0;color:var(--navy);font-size:16.5px}
.article-toggle summary small{color:var(--gold);font-weight:700;font-size:12px}
.article-toggle summary .plus{width:30px;height:30px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;color:var(--navy);font-size:16px;flex:none;transition:.25s}
.article-toggle[open] summary .plus{transform:rotate(45deg);background:var(--navy);color:#fff;border-color:var(--navy)}
.article-body{padding:0 24px 26px;color:#3B4550;font-size:14.5px;line-height:2}

/* ===== winding path journey (creative replacement for the compass wheel) ===== */
.path-journey{position:relative;max-width:340px;margin:28px auto 0;aspect-ratio:320/890}
.path-journey svg{position:absolute;inset:0;width:100%;height:100%}
.path-journey .track{fill:none;stroke:rgba(255,255,255,.16);stroke-width:5;stroke-linecap:round}
.path-journey .progress{fill:none;stroke:var(--gold);stroke-width:5;stroke-linecap:round;transition:stroke-dashoffset .5s cubic-bezier(.65,0,.35,1)}
.path-node{position:absolute;transform:translate(-50%,-50%);width:58px;height:58px;border-radius:50%;background:rgba(255,255,255,.08);border:2px solid rgba(255,255,255,.25);color:#EAF1F5;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;font:inherit;transition:.3s;z-index:2}
.path-node b{font-family:"Markazi Text";font-size:17px;line-height:1;display:block}
.path-node span{font-size:9.5px;line-height:1.15;max-width:48px;display:block;margin-top:2px}
.path-node.active{background:var(--gold);border-color:var(--gold);color:var(--navy-ink);box-shadow:0 10px 26px -8px rgba(185,134,47,.7);transform:translate(-50%,-50%) scale(1.12)}
.path-node.done:not(.active){background:rgba(224,177,94,.18);border-color:var(--gold-light);color:var(--gold-light)}
.path-node:hover:not(.active){border-color:var(--gold-light)}
.path-journey-detail{max-width:520px;margin:34px auto 0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:var(--seal);padding:22px 26px;min-height:118px}
.path-journey-detail small{color:var(--gold-light);font-weight:700;font-size:12px;letter-spacing:.5px}
.path-journey-detail h3{margin:6px 0;font-size:18px;color:#fff}
.path-journey-detail p{margin:0;font-size:14px;color:#D7E5EC}
@media(max-width:600px){
 .path-journey{max-width:270px}
 .path-node{width:50px;height:50px}
 .path-node b{font-size:15px}
 .path-node span{font-size:9px;max-width:42px}
}
.article-body h4{color:var(--navy);font-size:15px;margin:20px 0 8px}
.article-body p{margin:0 0 14px}
.article-body ul,.article-body ol{margin:0 0 14px;padding-inline-start:22px}
.article-body li{margin-bottom:6px}
.article-body .quote{border-inline-start:3px solid var(--gold);padding:4px 16px;color:var(--navy);font-style:normal;margin:16px 0}
.article-foot{margin-top:16px;padding-top:14px;border-top:1px solid var(--line-soft);font-size:12.5px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap}
.article-foot a{color:var(--navy);font-weight:700}

@media(max-width:600px){
 .library-shell{grid-template-columns:1fr}
 .lib-sidebar{position:static;flex-direction:row;flex-wrap:wrap}
 .compass-wrap{--r:100px;width:270px;height:270px}
 .compass-node{width:56px;height:56px;margin:-28px;font-size:10px}
 .community-badge{flex-direction:column;text-align:center}
 .container{width:min(100% - 26px,1180px)}
 .nav-in{height:70px}
 section{padding:64px 0}
