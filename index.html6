<script>
/* بوصلة الخطوات والمراحل — النقر على أي محطة يُظهر بطاقتها فقط */
function selectCompass(btn){
 const wrap = btn.closest('.compass-block');
 wrap.querySelectorAll('.compass-node').forEach(n=>n.classList.remove('active'));
 btn.classList.add('active');
 const id = btn.dataset.target;
 wrap.querySelectorAll('.detail-box').forEach(d=>d.classList.toggle('active', d.dataset.id===id));
}

/* مسار الأداء — الطريق المتعرج التفاعلي */
(function(){
 var svg = document.querySelector('#perfPath svg');
 var progress = document.getElementById('perfProgress');
 var total = document.querySelectorAll('#perfPath .path-node').length;
 var totalLen = 0;
 function initProgress(){
   if(!progress) return;
   totalLen = progress.getTotalLength();
   progress.style.strokeDasharray = totalLen;
   setProgress(0);
 }
 function setProgress(idx){
   if(!progress || !totalLen) return;
   var frac = total>1 ? idx/(total-1) : 0;
   progress.style.strokeDashoffset = totalLen*(1-frac);
 }
 window.selectPathNode = function(btn){
   var idx = parseInt(btn.dataset.idx,10);
   document.querySelectorAll('#perfPath .path-node').forEach(function(n){
     var i = parseInt(n.dataset.idx,10);
     n.classList.toggle('active', i===idx);
     n.classList.toggle('done', i<idx);
   });
   var detail = document.getElementById('perfDetail');
   detail.querySelector('small').textContent = btn.dataset.tag;
   detail.querySelector('h3').textContent = btn.dataset.title;
   detail.querySelector('p').textContent = btn.dataset.desc;
   setProgress(idx);
 };
 if(document.readyState==='complete'){ initProgress(); }
 else{ window.addEventListener('load', initProgress); }
})();

/* مكتبة نِبراس — التبديل بين مراجع أساسية وثانوية */
function showLib(cat, btn){
 document.querySelectorAll('.lib-tab').forEach(t=>t.classList.remove('active'));
 btn.classList.add('active');
 document.querySelectorAll('.lib-item').forEach(el=>{
   el.style.display = el.dataset.cat===cat ? '' : 'none';
 });
}

function toggleSearch(){const x=document.getElementById('searchBox');x.style.display=x.style.display==='none'?'block':'none';if(x.style.display==='block')document.getElementById('searchInput').focus()}
const searchable=[
 ['قواعد المركز السعودي للتحكيم التجاري','مكتبة نِبراس'],['مبادئ UNIDROIT','مكتبة نِبراس'],['CISG','مكتبة نِبراس'],['قانون الأونسيترال','مكتبة نِبراس'],
 ['محمد الفقي','فريق نِبراس'],['بتول الزهراني','فريق نِبراس'],['ياسمين عبدالوهاب كامل','فريق نِبراس'],['عبد القادر بكري أغا','فريق نِبراس'],
 ['أسامة فتحي عبد القادر','فريق نِبراس'],['ميّاسة البلوي','فريق نِبراس'],['أحمد خلف جمعة','فريق نِبراس'],['مريم الأمين عبدالجليل','فريق نِبراس'],['ثراء العتيبي','فريق نِبراس'],
 ['من البحث إلى المرافعة','إثراء نِبراس'],['مرشدي نِبراس','مرشدي نِبراس']
];
function liveSearch(){
 const q=document.getElementById('searchInput').value.trim().toLowerCase();
 const box=document.getElementById('searchResults');
 if(!q){box.innerHTML='';return}
 const r=searchable.filter(x=>x[0].toLowerCase().includes(q)).slice(0,8);
 box.innerHTML=`<div style="background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px">${r.length?r.map(x=>`<div style="padding:10px;border-bottom:1px solid var(--line)"><b style="color:var(--navy)">${x[0]}</b><small style="display:block;color:var(--muted)">${x[1]}</small></div>`).join(''):'<div style="padding:12px;color:var(--muted)">لا توجد نتائج مطابقة.</div>'}</div>`;
}

</script>
